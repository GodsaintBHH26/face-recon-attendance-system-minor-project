# Server Port
PORT=5000

# PostgreSQL Database Configuration
# You can use a local PostgreSQL instance or a free cloud instance (Supabase, Neon, Render, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Alternative individual PostgreSQL settings:
# PGUSER=postgres
# PGHOST=localhost
# PGDATABASE=attendance_db
# PGPASSWORD=postgres
# PGPORT=5432

# Cloudinary Configuration (for student photo storage)
# Get your free credentials from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder where student photos will be isolated inside Cloudinary:
CLOUDINARY_FOLDER=face_attendance_system

# AI Face Recognition Model Settings (Runs locally offline on CPU via InsightFace ONNX)
FACE_MODEL_NAME=buffalo_s
FACE_SIMILARITY_THRESHOLD=0.4


